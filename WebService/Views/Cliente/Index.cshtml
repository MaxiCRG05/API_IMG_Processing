@{
	ViewBag.Title = "Index";
	Layout = "~/Views/Shared/Global.cshtml";
}

@Html.AntiForgeryToken()
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link href="~/Content/style.css" rel="stylesheet" />
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<title>Inicio</title>
</head>
<body>
	<header>
		<button class="logout-btn" title="Cerrar sesión" onclick="location.href='/Login/Logout'">
			<img src="~/Content/IMGS/LogOut.png" />
		</button>
		<div class="titulos">
			<!-- -->
			<h1>Bienvenido @Session["Nombre"].ToString().ToUpper()</h1>
			<h2>¿EN QUÉ PROYECTO TRABAJAREMOS HOY?</h2>
		</div>
	</header>
	<input onclick="crearProyecto()" type="submit" value="Crear nuevo proyecto">
	<div class="borde">
		<table>
			<thead>
				<tr>
					<th>Proyecto</th>
					<th class="modificacion">Fecha de modificación</th>
				</tr>
			</thead>
			<tbody>
				<tr>
					<td><a href="#">escritorio</a></td>
					<td>252531</td>
				</tr>
				<tr>
					<td><a href="#">lapices</a></td>
					<td>254125</td>
				</tr>
			</tbody>
		</table>
	</div>
	
</body>
</html>

<script>

	function crearProyecto() {
		Swal.fire({
			title: 'Crea tu proyecto',
			input: "text",
			inputLabel: "Ingresa el nombre para tu proyecto:",
			inputPlaceholder: 'Nombre del proyecto',
			showCancelButton: true,
			cancelButtonText: "Cancelar",
			confirmButtonText: "Crear"
		});
	}
</script>