@model List<WebService.Models.Proyecto>

@{
	ViewBag.Title = "Index";
	Layout = "~/Views/Shared/Global.cshtml";

	string nombreUsuario = "Invitado";
	if (Session["Nombre"] != null)
	{
		nombreUsuario = Session["Nombre"].ToString().ToUpper();
	}
}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link href="~/Content/style.css" rel="stylesheet" />
	<title>Mis Proyectos</title>
	<style>
		.acciones-proyecto {
			display: flex;
			gap: 10px;
		}

		.btn-editar, .btn-eliminar {
			padding: 5px 10px;
			border: none;
			border-radius: 4px;
			cursor: pointer;
		}

		.btn-editar {
			background-color: #4CAF50;
			color: white;
		}

		.btn-eliminar {
			background-color: #f44336;
			color: white;
		}
	</style>
</head>
<body>
	<header>
		<button class="logout-btn" title="Cerrar sesión" onclick="location.href='/Login/Logout'">
			<img src="~/Content/IMGS/LogOut.png" />
		</button>
		<div class="titulos">
			<h1>Bienvenido @ViewBag.NombreUsuario</h1>
			<h2>¿EN QUÉ PROYECTO TRABAJAREMOS HOY?</h2>
		</div>
	</header>

	<input type="button" value="Crear nuevo proyecto" onclick="location.href='@Url.Action("Proyecto", "Cliente")'" />

	<div class="borde">
		@if (Model.Count == 0)
		{
			<p>No tienes proyectos creados todavía.</p>
		}
		else
		{
			<table>
				<thead>
					<tr>
						<th>Proyecto</th>
						<th class="modificacion">Fecha de modificación</th>
						<th>Acciones</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var proyecto in Model)
					{
						<tr>
							<td>
								<a href="#">@proyecto.Nombre</a>
							</td>
							<td>@proyecto.FechaModificacion.ToString("dd/MM/yyyy HH:mm")</td>
							<td class="acciones-proyecto">
								<button class="btn-editar"
										onclick="location.href='@Url.Action("EditarProyecto", "Cliente", new { id = proyecto.ID })'">
									Editar
								</button>
								@using (Html.BeginForm("EliminarProyecto", "Cliente", new { id = proyecto.ID }, FormMethod.Post))
								{
									@Html.AntiForgeryToken()
									<button type="submit" class="btn-eliminar">Eliminar</button>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
</body>
</html>