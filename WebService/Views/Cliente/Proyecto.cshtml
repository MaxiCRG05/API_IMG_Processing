@model WebService.Models.Proyecto

@{
	ViewBag.Title = "Proyecto";
	Layout = "~/Views/Shared/Global.cshtml";
}
@Html.AntiForgeryToken()
<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="~/Content/CSS/ObjetoNuevo.css">
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols +Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=dehaze" />
	<style>
		.sin-objetos {
			display: flex;
			justify-content: center;
			align-items: center;
			text-align: center;
			margin-top: 50px;
			padding: 20px;
			z-index: 1;
		}
	</style>
</head>
<body>
	<header>
		<div class="header">
			<div class="retroceder">
				<span class="material-symbols-outlined">dehaze</span>
			</div>
			<h1>@Model.Nombre.ToUpper()</h1>
		</div>
	</header>
	<section>
		<article>
			<button type="submit" onclick="location.href='/IA/Crear?proyectoID=@Model.ID'">
				@(ViewBag.TieneRedNeuronal != null && ViewBag.TieneRedNeuronal ? "Modificar red neuronal" : "Crear red neuronal")
				<img src="~/Content/IMGS/red.svg" alt="">
			</button>

			@if (ViewBag.Objetos != null && ViewBag.Objetos.Count > 0)
			{
				<div class="opciones">
					<div class="etiqueta">Selecciona objetos para entrenar la IA<img src="~/Content/IMGS/opciones.svg" alt="opciones" class="flecha"></div>

					<div id="contadorSeleccionados" style="text-align: center; margin: 10px 0; font-weight: bold;">
						0 objetos seleccionados
					</div>

					<div class="select-options">
						@if (ViewBag.Objetos.Count > 2)
						{
							<div class="scroll-indicator">Desplázate para ver más objetos ↓</div>
						}

						@foreach (var objeto in ViewBag.Objetos)
						{
							<label class="opcion">
								<img src="data:image;base64,@Convert.ToBase64String(objeto.Imagen)" alt="@objeto.Nombre" class="objeto">
								@objeto.Nombre
								<input type="checkbox" class="objeto-checkbox" id="objeto_@objeto.ID">
								<span class="marcado"></span>
							</label>
						}
					</div>
				</div>
			}
			else
			{
				<div class="sin-objetos">
					No hay objetos disponibles en la categoría seleccionada para este proyecto.
				</div>
			}
			<button type="button" id="btnEntrenar">Entrenar red neuronal<img src="~/Content/IMGS/study.svg" alt="Entrenar"></button>
			<button type="submit">Subir imagen<img src="~/Content/IMGS/image.svg" alt="imagen"></button>
			<button type="submit">Reconocer objetos<img src="~/Content/IMGS/reconocer.svg" alt="Reconocer"></button>
		</article>
		<div class="preview-box">
			<img class="ImgObjeto" id="ImgObjeto" />
		</div>
	</section>
	<script src="~/Scripts/proyecto.js"></script>
	<div id="menuLateral" class="menu-lateral oculto">
		<div class="menu-header">
			<span class="close-menu" id="cerrarMenu"><img src="~/Content/IMGS/cerrar.svg" alt="Cerrar menú"></span>
		</div>
		<ul class="menu-lista">
			<li onclick="guardarProyecto(@Model.ID)"><img src="~/Content/IMGS/save-negro.svg" alt="Guardar" class="menu-icono"> Guardar</li>
			<li class="submenu">
				<img src="~/Content/IMGS/modificar.svg" alt="Modificar proyecto" class="menu-icono"> Modificar proyecto
				<ul class="subopciones">
					<li><img src="~/Content/IMGS/modificar.svg" alt="Modificar nombre del proyecto" class="menu-icono"> Modificar nombre</li>
					<li onclick="location.href='/IA/Crear?proyectoID=@Model.ID'"><img src="~/Content/IMGS/red-negro.svg" alt="Modificar red neuronal" class="menu-icono"> Modificar arquitectura</li>
				</ul>
			</li>
			<li onclick="salirDelProyecto(@Model.ID)"><img src="~/Content/IMGS/salir.svg" alt="Salir" class="menu-icono"> Salir del proyecto</li>
			<li onclick="alertaBorrar(@Model.ID)"><img src="~/Content/IMGS/borrar.svg" alt="Borrar" class="menu-icono"> Eliminar proyecto</li>
		</ul>
	</div>
</body>
</html>

<script>
	function guardarProyecto(proyectoID) {
		console.log('Guardando proyecto:', proyectoID);

		const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

		Swal.fire({
			title: 'Guardando...',
			text: 'Por favor espere',
			allowOutsideClick: false,
			didOpen: () => {
				Swal.showLoading();
			}
		});

		const formData = new FormData();
		formData.append('proyectoID', proyectoID.toString());
		formData.append('__RequestVerificationToken', token);

		fetch('/Cliente/ActualizarFechaModificacion', {
			method: 'POST',
			body: formData
		})
			.then(response => {
				console.log('Response status:', response.status);
				if (!response.ok) {
					return response.text().then(text => {
						throw new Error(`HTTP ${response.status}: ${text}`);
					});
				}
				return response.json();
			})
			.then(data => {
				Swal.close();
				if (data.success) {
					Swal.fire({
						icon: 'success',
						title: '¡Guardado!',
						text: data.message,
						timer: 2000,
						showConfirmButton: false
					});
				} else {
					Swal.fire({
						icon: 'error',
						title: 'Error',
						text: data.message
					});
				}
			})
			.catch(error => {
				Swal.close();
				console.error('Error completo:', error);
				Swal.fire({
					icon: 'error',
					title: 'Error de conexión',
					text: error.message
				});
			});
	}

	function salirDelProyecto(proyectoID) {
		Swal.fire({
			title: '¿Salir del proyecto?',
			text: 'Se guardarán los cambios automáticamente',
			icon: 'question',
			showCancelButton: true,
			confirmButtonColor: '#3085d6',
			cancelButtonColor: '#d33',
			confirmButtonText: 'Sí, salir',
			cancelButtonText: 'Cancelar'
		}).then((result) => {
			if (result.isConfirmed) {
				guardarProyecto(proyectoID);
				setTimeout(() => {
					window.location.href = '/Cliente';
				}, 1000);
			}
		});
	}

	function alertaBorrar(proyectoID) {
		Swal.fire({
			title: '¿Estás seguro?',
			text: "¡No podrás revertir esta acción!",
			icon: 'warning',
			showCancelButton: true,
			confirmButtonColor: '#3085d6',
			cancelButtonColor: '#d33',
			confirmButtonText: 'Sí, eliminar',
			cancelButtonText: 'Cancelar'
		}).then((result) => {
			if (result.isConfirmed) {
				borrarProyecto(proyectoID);
			}
		});
	}

	function borrarProyecto(proyectoID) {
		Swal.fire({
			title: '¿Estás seguro?',
			text: "¡No podrás revertir esta acción!",
			icon: 'warning',
			showCancelButton: true,
			confirmButtonColor: '#3085d6',
			cancelButtonColor: '#d33',
			confirmButtonText: 'Sí, borrar proyecto',
			cancelButtonText: 'Cancelar'
		}).then((result) => {
			if (result.isConfirmed) {
				const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

				const formData = new FormData();
				formData.append('id', proyectoID);
				formData.append('__RequestVerificationToken', token);

				fetch('/Cliente/EliminarProyecto', {
					method: 'POST',
					body: formData
				})
					.then(response => {
						if (response.redirected) {
							window.location.href = response.url;
						} else {
							return response.json();
						}
					})
					.then(data => {
						if (data && data.success) {
							window.location.href = '/Cliente';
						} else if (data && !data.success) {
							Swal.fire(
								'Error',
								'No se pudo eliminar el proyecto: ' + data.message,
								'error'
							);
						}
					})
					.catch(error => {
						Swal.fire(
							'Error',
							'No se pudo eliminar el proyecto: ' + error,
							'error'
						);
					});
			}
		});
	}

	document.addEventListener('DOMContentLoaded', function() {
		const proyectoID = @Model.ID;
		const checkboxes = document.querySelectorAll('.objeto-checkbox');
		const contador = document.getElementById('contadorSeleccionados');
		const btnEntrenar = document.getElementById('btnEntrenar');

		if (!contador || !btnEntrenar) {
			console.error('No se encontraron elementos requeridos en el DOM');
			return;
		}

		function actualizarContador() {
			const seleccionados = document.querySelectorAll('.objeto-checkbox:checked').length;
			contador.textContent = `${seleccionados} objetos seleccionados`;
			btnEntrenar.disabled = seleccionados === 0;
		}

		checkboxes.forEach(checkbox => {
			checkbox.addEventListener('change', function() {
				const item = this.closest('.opcion');
				if (this.checked) {
					item.classList.add('seleccionado');
				} else {
					item.classList.remove('seleccionado');
				}
				actualizarContador();
			});
		});

		function obtenerObjetosSeleccionados() {
			const seleccionados = [];
			document.querySelectorAll('.objeto-checkbox:checked').forEach(checkbox => {
				const id = checkbox.id.replace('objeto_', '');
				seleccionados.push(parseInt(id));
			});
			return seleccionados;
		}

		btnEntrenar.addEventListener('click', function() {
			const objetosSeleccionados = obtenerObjetosSeleccionados();

			if (objetosSeleccionados.length === 0) {
				Swal.fire({
					icon: 'warning',
					title: 'Selección requerida',
					text: 'Por favor, selecciona al menos un objeto para entrenar.'
				});
				return;
			}

			const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

			Swal.fire({
				title: 'Guardando...',
				text: 'Preparando el entrenamiento',
				allowOutsideClick: false,
				didOpen: () => {
					Swal.showLoading();
				}
			});

			fetch('/Cliente/ActualizarFechaModificacion', {
				method: 'POST',
				headers: {
					'RequestVerificationToken': token
				},
				body: JSON.stringify({ proyectoID: @Model.ID }),
				credentials: 'same-origin'
			})
			.then(response => {
				if (!response.ok) {
					throw new Error('Error al guardar el proyecto');
				}
				return response.json();
			})
			.then(data => {
				if (!data.success) {
					throw new Error(data.message);
				}

				return fetch('/IA/Entrenar', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
						'RequestVerificationToken': token
					},
					body: JSON.stringify({
						proyectoId: @Model.ID,
						objetos: objetosSeleccionados
					})
				});
			})
			.then(response => {
				if (!response.ok) {
					throw new Error('Error en la respuesta del servidor');
				}
				return response.json();
			})
			.then(data => {
				Swal.close();
				if (data.success) {
					Swal.fire({
						icon: 'success',
						title: '¡Entrenamiento iniciado!',
						text: 'El proyecto ha sido guardado y el entrenamiento se ha iniciado correctamente.',
						timer: 3000,
						showConfirmButton: false
					});
				} else {
					Swal.fire({
						icon: 'error',
						title: 'Error',
						text: 'Error al iniciar el entrenamiento: ' + data.message
					});
				}
			})
			.catch(error => {
				Swal.close();
				console.error('Error:', error);
				Swal.fire({
					icon: 'error',
					title: 'Error',
					text: error.message
				});
			});
		});

		actualizarContador();
	});

	window.addEventListener('beforeunload', function(e) {
		const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

		const data = { proyectoID: @Model.ID };
		const formData = new FormData();
		formData.append('proyectoID', @Model.ID);
		navigator.sendBeacon('/Cliente/ActualizarFechaModificacion', formData);
	});
</script>