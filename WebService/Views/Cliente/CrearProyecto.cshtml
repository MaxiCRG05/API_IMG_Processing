@model WebService.Models.Proyecto
@{
	ViewBag.Title = "Crear Nuevo Proyecto";
	Layout = null;
}

<h2>NUEVO PROYECTO</h2>

@using (Html.BeginForm())
{
	
	@Html.AntiForgeryToken()

	<div class="form-group">
		@Html.LabelFor(model => model.Nombre, "Nombre del proyecto")
		@Html.TextBoxFor(model => model.Nombre,
			new
				 {
				@class = "form-control",
				placeholder = "Ej. Objetos de escritorio",
				required = "required"
			})
		@Html.ValidationMessageFor(model => model.Nombre)
	</div>

	<div class="form-group">
		<label>Seleccione las categorías</label>
		<div class="categorias-container">
			@foreach (var categoria in ViewBag.Categorias)
			{
				<div class="categoria-item">
					<input type="checkbox"
						   name="categoriasSeleccionadas"
						   value="@categoria.ID"
						   id="categoria_@categoria.ID" />
					<label for="categoria_@categoria.ID">@categoria.Nombre</label>
				</div>
			}
		</div>
	</div>

	<div class="form-actions">
		<button type="submit" class="btn btn-primary">Crear</button>
		<a href="@Url.Action("Index")" class="btn btn-default">Cancelar</a>
	</div>
}