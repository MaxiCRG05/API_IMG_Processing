@{
	ViewBag.Title = "Crear IA";
	Layout = "~/Views/Shared/GlobalAdmin.cshtml";
}

<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="utf-8" />
	<title>@ViewBag.Title</title>
	<link href="~/Content/CSS/IA.css" rel="stylesheet" />
	<style>
		.diagram-section {
			position: relative;
			min-height: 600px;
		}

		#diagramaRed {
			position: relative;
			width: 100%;
			min-height: 500px;
		}

		.form-section input[type="number"] {
			min-width: 400px;
			padding: 12px;
			margin: 20px 0px 20px 0px;
			border-radius: 20px;
			border: 2px solid #aac0d4;
			font-size: 16px;
			transition: 0.3s ease-in-out;
		}

		.hidden {
			display: none;
		}

		.capa-oculta {
			margin: 10px 0;
			padding: 10px;
			border: 1px solid #ddd;
			border-radius: 5px;
		}
	</style>
</head>
<body>
	<header>
		<div class="header">
			<button class="return-btn" title="Regresar" onclick="location.href='/Cliente/Proyecto?proyectoID=@ViewBag.ProyectoID'">
				<img src="~/Content/IMGS/FlechaRegresar.png" width="20" />
			</button>
			<h1>ARQUITECTURA DE LA IA</h1>
		</div>
	</header>

	<div class="container">
		<div class="form-section">
			<form method="post" action="/IA/Crear" id="formRedNeuronal">
				@Html.AntiForgeryToken() 
				<input type="hidden" name="proyectoID" value="@ViewBag.ProyectoID" />

				<label for="totalCapas">N° Total de Capas</label><br />
				<input type="number" id="totalCapas" name="totalCapas" min="3" max="10" placeholder="(Mínimo de 3 y Máximo de 10) Ej. 8" required />

				<label for="numNeuronasCapaEntrada">N° de Neuronas en Capa de Entrada</label><br />
				<input type="number" id="numNeuronasCapaEntrada" name="numNeuronasCapaEntrada" min="1" max="7" placeholder="(Mínimo de 1 y Máximo de 7) Ej. 7" oninput="actualizarDiagrama()" required />

				<div id="capasOcultasContainer"></div>

				<label for="numNeuronasCapaSalida">N° de Neuronas en Capa de Salida</label><br />
				<input type="number" id="numNeuronasCapaSalida" name="numNeuronasCapaSalida" min="1" max="10" placeholder="(Mínimo de 1) Ej. 5" oninput="actualizarDiagrama()" required />

				<label for="alfa">Alfa (Tasa de Aprendizaje)</label><br />
				<input type="number" step="0.001" id="alfa" name="alfa" placeholder="Ej. 0.1" required />

				<label for="errorMinimo">Error Mínimo a alcanzar</label><br />
				<input type="number" step="0.00001" name="errorMinimo" placeholder="Ej. 0.00001" required />

				<label for="epocas">Epocas para el Entrenamiento</label><br />
				<input type="number" name="epocas" placeholder="(Mínimo de 10000) Ej. 10000" required />

				<button type="submit" class="btn-crear">Crear Red Neuronal</button>
			</form>
		</div>

		<div class="diagram-section">
			<div id="diagramaRed"></div>
		</div>
	</div>

	<script>
		document.getElementById('totalCapas').addEventListener('change', function () {
			generarCamposCapasOcultas(this.value);
			actualizarDiagrama();
		});

		document.getElementById('numNeuronasCapaEntrada').addEventListener('input', actualizarDiagrama);
		document.getElementById('numNeuronasCapaSalida').addEventListener('input', actualizarDiagrama);

		function generarCamposCapasOcultas(totalCapas) {
			const container = document.getElementById('capasOcultasContainer');
			container.innerHTML = '';

			const numCapasOcultas = totalCapas - 2;

			for (let i = 1; i <= numCapasOcultas; i++) {
				const div = document.createElement('div');
				div.className = 'capa-oculta';
				div.innerHTML = `
            <label for="capaOculta${i}">N° de Neuronas en Capa Oculta ${i}</label>
            <input type="number" id="capaOculta${i}" name="numNeuronasNCapas" min="1" placeholder="Ej. 5" required oninput="actualizarDiagrama()" />
        `;
				container.appendChild(div);
			}
		}

		function dibujarConexiones(contenedor, capas) {
			const conexionesAnteriores = contenedor.querySelector('.conexiones');
			if (conexionesAnteriores) {
				conexionesAnteriores.classList.add('fade-out');
				setTimeout(() => {
					conexionesAnteriores.remove();
				}, 300);
			}

			setTimeout(() => {
				const conexionesContainer = document.createElement('div');
				conexionesContainer.className = 'conexiones fade-in';

				const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
				svg.setAttribute('width', '100%');
				svg.setAttribute('height', '100%');
				svg.style.position = 'absolute';
				svg.style.top = '0';
				svg.style.left = '0';
				svg.style.pointerEvents = 'none';

				for (let i = 0; i < capas.length - 1; i++) {
					const capaActual = capas[i].querySelector('.capa-neuronas');
					const capaSiguiente = capas[i + 1].querySelector('.capa-neuronas');

					if (!capaActual || !capaSiguiente) continue;

					const neuronasActual = capaActual.querySelectorAll('.neurona');
					const neuronasSiguiente = capaSiguiente.querySelectorAll('.neurona');

					neuronasActual.forEach((neuronaActual, indexActual) => {
						const rectActual = neuronaActual.getBoundingClientRect();
						const rectContenedor = contenedor.getBoundingClientRect();

						const x1 = rectActual.left + rectActual.width / 2 - rectContenedor.left;
						const y1 = rectActual.top + rectActual.height / 2 - rectContenedor.top;

						neuronasSiguiente.forEach((neuronaSiguiente, indexSiguiente) => {
							const rectSiguiente = neuronaSiguiente.getBoundingClientRect();
							const x2 = rectSiguiente.left + rectSiguiente.width / 2 - rectContenedor.left;
							const y2 = rectSiguiente.top + rectSiguiente.height / 2 - rectContenedor.top;

							const linea = document.createElementNS('http://www.w3.org/2000/svg', 'line');
							linea.setAttribute('x1', x1);
							linea.setAttribute('y1', y1);
							linea.setAttribute('x2', x2);
							linea.setAttribute('y2', y2);
							linea.setAttribute('class', 'conexion');

							linea.style.opacity = '0';
							linea.style.transition = 'opacity 0.4s ease-in-out';

							setTimeout(() => {
								linea.style.opacity = '0.6';
							}, (indexActual + indexSiguiente) * 20);

							svg.appendChild(linea);
						});
					});
				}

				conexionesContainer.appendChild(svg);
				contenedor.appendChild(conexionesContainer);

				setTimeout(() => {
					conexionesContainer.classList.remove('fade-in');
				}, 500);
			}, 400);
		}

		let ultimaActualizacion = 0;
		const DEBOUNCE_DELAY = 300;

		function actualizarDiagrama() {
			const ahora = Date.now();
			if (ahora - ultimaActualizacion < DEBOUNCE_DELAY) {
				return;
			}
			ultimaActualizacion = ahora;

			const totalCapas = parseInt(document.getElementById('totalCapas').value) || 0;
			const diagrama = document.getElementById('diagramaRed');

			if (totalCapas < 3 || totalCapas > 10) {
				mostrarMensajeValidacion(diagrama);
				return;
			}

			const neuronasPorCapa = obtenerNumeroNeuronasPorCapa();

			const diagramaExistente = diagrama.querySelector('.red-diagram');
			if (diagramaExistente) {
				actualizarDiagramaExistente(diagramaExistente, totalCapas, neuronasPorCapa);
			} else {
				crearNuevoDiagrama(diagrama, totalCapas, neuronasPorCapa);
			}
		}

		function mostrarMensajeValidacion(diagrama) {
			if (diagrama.innerHTML !== '') {
				diagrama.classList.add('fade-out');
				setTimeout(() => {
					diagrama.innerHTML = '<p>Ingresa un mínimo de 3 capas pero un máximo de 10 capas para ver el diagrama</p>';
					diagrama.classList.remove('fade-out');
					diagrama.classList.add('fade-in');
				}, 300);
			} else {
				diagrama.innerHTML = '<p>Ingresa un mínimo de 3 capas pero un máximo de 10 capas para ver el diagrama</p>';
				diagrama.classList.add('fade-in');
			}
		}

		function crearNuevoDiagrama(diagrama, totalCapas, neuronasPorCapa) {
			generarDiagramaHTML(diagrama, totalCapas, neuronasPorCapa);
			diagrama.classList.add('fade-in');

			setTimeout(() => {
				diagrama.classList.remove('fade-in');
				centrarYConectarNeuronas(diagrama, totalCapas);
			}, 500);
		}

		function actualizarDiagramaExistente(diagramaExistente, totalCapas, nuevasNeuronasPorCapa) {
			const capasActuales = diagramaExistente.querySelectorAll('.capa-container');
			let hayCambiosEstructurales = false;

			if (capasActuales.length !== totalCapas) {
				hayCambiosEstructurales = true;
			}

			if (hayCambiosEstructurales) {
				const diagrama = document.getElementById('diagramaRed');
				diagrama.classList.add('fade-out');
				setTimeout(() => {
					generarDiagramaHTML(diagrama, totalCapas, nuevasNeuronasPorCapa);
					diagrama.classList.remove('fade-out');
					diagrama.classList.add('fade-in');
					setTimeout(() => {
						diagrama.classList.remove('fade-in');
						centrarYConectarNeuronas(diagrama, totalCapas);
					}, 500);
				}, 300);
			} else {
				actualizarNeuronasProgresivamente(diagramaExistente, nuevasNeuronasPorCapa, totalCapas);
			}
		}

		function actualizarNeuronasProgresivamente(diagramaExistente, nuevasNeuronasPorCapa, totalCapas) {
			const capas = diagramaExistente.querySelectorAll('.capa-container');

			capas.forEach((capa, indexCapa) => {
				const neuronasContainer = capa.querySelector('.capa-neuronas');
				const neuronasActuales = neuronasContainer.querySelectorAll('.neurona');
				const nuevasNeuronas = nuevasNeuronasPorCapa[indexCapa] || 1;

				if (neuronasActuales.length > nuevasNeuronas) {
					for (let i = nuevasNeuronas; i < neuronasActuales.length; i++) {
						setTimeout(() => {
							if (neuronasActuales[i]) {
								neuronasActuales[i].classList.add('neurona-disappear');
								setTimeout(() => {
									if (neuronasActuales[i].parentNode) {
										neuronasActuales[i].remove();
									}
								}, 400);
							}
						}, i * 50);
					}
				}
			});

			setTimeout(() => {
				capas.forEach((capa, indexCapa) => {
					const neuronasContainer = capa.querySelector('.capa-neuronas');
					const neuronasActuales = neuronasContainer.querySelectorAll('.neurona');
					const nuevasNeuronas = nuevasNeuronasPorCapa[indexCapa] || 1;

					neuronasActuales.forEach((neurona, index) => {
						if (index < nuevasNeuronas) {
							neurona.textContent = index + 1;
							if (index >= neuronasActuales.length) {
								neurona.classList.add('neurona-appear');
							}
						}
					});

					if (neuronasActuales.length < nuevasNeuronas) {
						for (let i = neuronasActuales.length; i < nuevasNeuronas; i++) {
							setTimeout(() => {
								const nuevaNeurona = document.createElement('div');
								const tipoCapa = indexCapa === 0 ? 'entrada' :
									indexCapa === totalCapas - 1 ? 'salida' : 'oculta';

								nuevaNeurona.className = `neurona ${tipoCapa} neurona-appear`;
								nuevaNeurona.textContent = i + 1;
								nuevaNeurona.style.animationDelay = `${i * 0.1}s`;

								neuronasContainer.appendChild(nuevaNeurona);
							}, i * 100);
						}
					}
				});

				setTimeout(() => {
					const diagrama = document.getElementById('diagramaRed');
					centrarYConectarNeuronas(diagrama, totalCapas);
				}, Math.max(...nuevasNeuronasPorCapa) * 100 + 500);

			}, 400);
		}

		function generarDiagramaHTML(diagrama, totalCapas, neuronasPorCapa) {
			let html = '<h3>Diagrama de la Red Neuronal</h3><div class="red-diagram">';

			html += `
        <div class="capa-container">
            <div class="capa-titulo">Capa de Entrada</div>
            <div class="capa-neuronas entrada">
    `;
			for (let i = 0; i < neuronasPorCapa[0]; i++) {
				html += `<div class="neurona entrada neurona-appear" style="animation-delay: ${i * 0.1}s;">${i + 1}</div>`;
			}
			html += '</div></div>';

			for (let i = 1; i <= totalCapas - 2; i++) {
				html += `
            <div class="capa-container">
                <div class="capa-titulo">Capa Oculta ${i}</div>
                <div class="capa-neuronas oculta">
        `;
				for (let j = 0; j < (neuronasPorCapa[i] || 1); j++) {
					html += `<div class="neurona oculta neurona-appear" style="animation-delay: ${(i + j) * 0.1}s;">${j + 1}</div>`;
				}
				html += '</div></div>';
			}

			html += `
        <div class="capa-container">
            <div class="capa-titulo">Capa de Salida</div>
            <div class="capa-neuronas salida">
    `;
			for (let i = 0; i < neuronasPorCapa[neuronasPorCapa.length - 1]; i++) {
				html += `<div class="neurona salida neurona-appear" style="animation-delay: ${(totalCapas + i) * 0.1}s;">${i + 1}</div>`;
			}
			html += '</div></div>';

			html += '</div>';
			diagrama.innerHTML = html;
		}

		function centrarYConectarNeuronas(diagrama, totalCapas) {
			const contenedorDiagrama = diagrama.querySelector('.red-diagram');
			const capas = contenedorDiagrama.querySelectorAll('.capa-container');

			let maxAltura = 0;
			capas.forEach(capa => {
				const neuronasContainer = capa.querySelector('.capa-neuronas');
				if (neuronasContainer.offsetHeight > maxAltura) {
					maxAltura = neuronasContainer.offsetHeight;
				}
			});

			capas.forEach(capa => {
				const neuronasContainer = capa.querySelector('.capa-neuronas');
				const neuronas = neuronasContainer.querySelectorAll('.neurona');

				neuronasContainer.style.minHeight = maxAltura + 'px';

				const totalNeuronas = neuronas.length;
				if (totalNeuronas > 0) {
					const espacioTotal = maxAltura;
					const alturaNeuronas = 60;
					const espacioEntreNeuronas = 25;
					const espacioOcupado = (totalNeuronas * alturaNeuronas) +
						((totalNeuronas - 1) * espacioEntreNeuronas);

					const espacioExtra = espacioTotal - espacioOcupado;
					const margenSuperior = Math.max(0, espacioExtra / 2);

					neuronasContainer.style.justifyContent = 'flex-start';
					neuronasContainer.style.paddingTop = margenSuperior + 'px';
				}
			});

			dibujarConexiones(contenedorDiagrama, capas);
		}

		document.getElementById('formRedNeuronal').addEventListener('submit', function (e) {
			const token = document.querySelector('input[name="__RequestVerificationToken"]');
			if (!token) {
				e.preventDefault();
				console.error('Token antifalsificación no encontrado');
				alert('Error de seguridad. Por favor, recarga la página e intenta nuevamente.');
				return false;
			}

			const totalCapas = parseInt(document.getElementById('totalCapas').value);
			const capasOcultas = document.querySelectorAll('input[name="numNeuronasNCapas"]').length;

			const inputsOcultos = document.querySelectorAll('input[name="numNeuronasNCapas"]');
			let todosLlenos = true;

			inputsOcultos.forEach(input => {
				if (!input.value || parseInt(input.value) < 1) {
					todosLlenos = false;
				}
			});

			if (totalCapas - 2 !== capasOcultas || !todosLlenos) {
				e.preventDefault();
				alert('Por favor, complete todas las capas ocultas con valores válidos');
				return false;
			}

			const neuronasPorCapa = obtenerNumeroNeuronasPorCapa();
			if (neuronasPorCapa.length !== totalCapas) {
				e.preventDefault();
				alert('El número total de capas no coincide con la configuración');
				return false;
			}
		});

		function obtenerNumeroNeuronasPorCapa() {
			const numEntrada = parseInt(document.getElementById('numNeuronasCapaEntrada').value) || 0;
			const numSalida = parseInt(document.getElementById('numNeuronasCapaSalida').value) || 0;

			const neuronasOcultas = [];
			const inputsOcultos = document.querySelectorAll('input[name="numNeuronasNCapas"]');
			inputsOcultos.forEach(input => {
				neuronasOcultas.push(parseInt(input.value) || 0);
			});

			return [numEntrada, ...neuronasOcultas, numSalida];
		}

		window.addEventListener('DOMContentLoaded', () => {
			const totalCapas = document.getElementById('totalCapas').value;
			if (totalCapas && totalCapas >= 3) {
				generarCamposCapasOcultas(totalCapas);
				actualizarDiagrama();
			}
		});
	</script>
</body>
</html>