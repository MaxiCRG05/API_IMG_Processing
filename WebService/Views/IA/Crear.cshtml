@{
	ViewBag.Title = "Crear";
	Layout = "~/Views/Shared/GlobalAdmin.cshtml";
}

<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="utf-8" />
	<title>@ViewBag.Title</title>
	<style>
		body {
			font-family: Arial, sans-serif;
			margin: 0;
			padding: 0;
		}

		.container {
			display: flex;
			flex-direction: row;
			justify-content: space-between;
			padding: 50px;
		}

		.form-section {
			flex: 1;
			max-width: 400px;
		}

		label {
			font-weight: bold;
			margin-top: 15px;
			display: block;
		}

		input[type="text"] {
			width: 100%;
			padding: 10px;
			margin-top: 5px;
			border: 1px solid #ccc;
			border-radius: 5px;
		}

		.button-group {
			margin-top: 30px;
			display: flex;
			justify-content: space-between;
			align-self: center;
		}

		.btn {
			padding: 10px 20px;
			border: none;
			border-radius: 8px;
			cursor: pointer;
			font-size: 16px;
			transition: 0.3s ease-in-out;
		}

		.btn-save {
			background-color: #8aa8c7;
			color: white;
		}

		.btn-cancel {
			background-color: white;
			border: 2px solid #8aa8c7;
			color: #0c1b36;
		}

		.btn:hover {
			background-color: #304D6D;
			color: white;
		}


		.diagram-section {
			flex: 1;
			text-align: center;
		}

			.diagram-section img {
				max-width: 100%;
				height: auto;
			}

		.return-btn {
			position: absolute;
			top: 20px;
			left: 20px;
			background-color: #82A0BC;
			border: none;
			border-radius: 40px;
			padding: 13px 25px 13px 25px;
			cursor: pointer;
			transition: background-color 0.3s ease;
		}

			.return-btn:hover {
				background-color: #5a768f;
			}
	</style>
</head>
<body>
	<div class="header">
		<button class="return-btn" title="Regresar" onclick="location.href='/'">
			<img src="~/Content/IMGS/FlechaRegresar.png" width="20" />
		</button>
		<h1>ARQUITECTURA DE LA IA</h1>
	</div>

	<div class="container">
		<div class="form-section">
			<form method="post" action="/RedNeuronal/Guardar">
				<label for="capas">N° de Capas</label>
				<input type="text" id="capas" name="capas" placeholder="Ej. 4" min="3" max="10" />

				<label for="capasOcultas">N° de Capas ocultas</label>
				<input type="text" id="capasOcultas" name="capasOcultas" placeholder="Ej. 2" min="1" max="" />

				<label for="neuronaCapa">N° de Neuronas en capa oculta </label>
				<input type="text" id="neuronaCapa" name="neuronaCapa" placeholder="Ej. 0.75" />

				<label for="alfa">Alfa</label>
				<input type="text" id="alfa" name="alfa" placeholder="Ej. 0.75" />

				<label for="epocas">Épocas</label>
				<input type="text" id="epocas" name="epocas" placeholder="Ej. 10000" />

				<label for="errorMin">Error mínimo</label>
				<input type="text" id="errorMin" name="errorMin" placeholder="Ej. 0.00001" />

				<div class="button-group">
					<button type="submit" class="btn btn-save">Guardar <img src="~/Content/IMGS/Save.png" />
					</button>
					<button type="button" class="btn btn-cancel" onclick="window.location.href='@Url.Action("Index", "Home")'">Cancelar <img src="~/Content/IMGS/Cruz3.png" />
					</button>
				</div>
			</form>
		</div>

		<div class="diagram-section">
			@{
				//<img src="" alt="Diagrama Red Neuronal" />
			}
		</div>
	</div>
</body>
</html>