@{
	ViewBag.Title = "Crear";
	Layout = "~/Views/Shared/GlobalAdmin.cshtml";
}

<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="utf-8" />
	<title>@ViewBag.Title</title>
</head>
<body>
	<header>
		<div class="header">
			<button class="return-btn" title="Regresar" onclick="location.href='/Cliente/Proyecto?proyectoID=@ViewBag.ProyectoID'">
				<img src="~/Content/IMGS/FlechaRegresar.png" width="20" />
			</button>
			<h1>ARQUITECTURA DE LA IA</h1>
		</div>
	</header>

	<div class="container">
		<div class="form-section">
			<form method="post" action="/RedNeuronal/Guardar">
				<label for="capas">N° de Capas</label>
				<input type="text" id="capas" name="capas" placeholder="Ej. 4" min="3" max="10" />

				<label for="capasOcultas">N° de Capas ocultas</label>
				<input type="text" id="capasOcultas" name="capasOcultas" placeholder="Ej. 2" min="1" max="" />

				<label for="neuronaCapa">N° de Neuronas en capa oculta </label>
				<input type="text" id="neuronaCapa" name="neuronaCapa" placeholder="Ej. 0.75" />

				<label for="alfa">Alfa</label>
				<input type="text" id="alfa" name="alfa" placeholder="Ej. 0.75" />

				<label for="epocas">Épocas</label>
				<input type="text" id="epocas" name="epocas" placeholder="Ej. 10000" />

				<label for="errorMin">Error mínimo</label>
				<input type="text" id="errorMin" name="errorMin" placeholder="Ej. 0.00001" />

				<div class="button-group">
					<button type="submit" class="btn btn-save">Guardar <img src="~/Content/IMGS/Save.png" />
					</button>
					<button type="button" class="btn btn-cancel" onclick="window.location.href='@Url.Action("Index", "Home")'">Cancelar <img src="~/Content/IMGS/Cruz3.png" />
					</button>
				</div>
			</form>
		</div>

		<div class="diagram-section">
			@{
				//<img src="" alt="Diagrama Red Neuronal" />
			}
		</div>
	</div>
</body>
</html>