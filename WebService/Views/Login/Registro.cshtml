@{
	ViewBag.Title = "Registro";
	Layout = null;
}

<head>
	<link rel="stylesheet" href="~/Content/CSS/Login.css" />
	<link rel="stylesheet" href="~/Content/CSS/Usuario.css" />
</head>
<button class="return-btn" title="Regresar" onclick="location.href='/Login'">
	<img src="~/Content/IMGS/FlechaRegresar.png" width="20" />
</button>
<div class="login-container">
	<h1>¡Nuevo usuario!</h1>
	<h2>Por favor ingresa los siguientes datos para crear tu usuario en la plataforma y empezar a crear objetos.</h2>
	<form action="/Login/Registro" method="post" id="registroForm">
		@Html.AntiForgeryToken()
		<input type="text" name="nombre" id="nombre" placeholder="Nombre" maxlength="30" required>
		<input type="email" name="correo" id="correo" placeholder="Correo" required>
		<input type="password" name="contraseña" id="contraseña" placeholder="Contraseña" required>
		<button type="submit" class="login-btn">Registrar<img src="~/Content/IMGS/persona.svg" alt="nuevo usuario"></button>
	</form>
	<div class="signup-link">
		¿Ya eres usuario? <a href="/Login">Iniciar sesión</a>
	</div>
</div>
<script>
	document.addEventListener('DOMContentLoaded', function() {
		if ('@ViewBag.Success' === 'True') {
			registroExitoso();
		}
		else if ('@ViewBag.ErrorType' === 'CorreoExistente') {
			correoExistente();
		}
		else if ('@ViewBag.ErrorType' === 'ErrorGeneral') {
			errorRegistro();
		}

		document.getElementById('registroForm').addEventListener('submit', function (e) {
			const contraseña = document.getElementById('contraseña').value;

			if (contraseña.length < 8) {
				e.preventDefault();
				contraseñaInvalida();
			}
		});
	});

	function contraseñaInvalida() {
		Swal.fire({
			icon: 'error',
			title: 'Contraseña inválida',
			text: 'La contraseña debe tener al menos 8 caracteres.',
			timer: 3000,
			confirmButtonText: 'Aceptar'
		});
	}

	function registroExitoso() {
		Swal.fire({
			icon: 'success',
			title: 'Registro exitoso',
			text: 'Tu usuario ha sido creado correctamente.',
			timer: 3000,
			confirmButtonText: 'Aceptar'
		}).then(() => {
			window.location.href = '/Cliente';
		});
	}

	function correoExistente() {
		Swal.fire({
			icon: 'error',
			title: 'Error',
			text: 'El correo electrónico ya está registrado.',
			timer: 3000,
			confirmButtonText: 'Aceptar'
		});
	}

	function errorRegistro() {
		Swal.fire({
			icon: 'error',
			title: 'Error',
			text: 'Ocurrió un error al registrar el usuario. Por favor, inténtalo de nuevo.',
			timer: 3000,
			confirmButtonText: 'Aceptar'
		});
	}
</script>