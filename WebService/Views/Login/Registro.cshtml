
@{
	ViewBag.Title = "Registro";
	Layout = "~/Views/Shared/Global.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=arrow_left_alt" />
	<link href="~/Content/Usuario.css" rel="stylesheet" />
	<title>Registro</title>
</head>
<body>
	<div class="contenedor-formulario">
		<button class="return-btn" title="Regresar" onclick="location.href='/Login'">
			<img src="~/Content/IMGS/FlechaRegresar.png" width="20" />
		</button>
		<h1>¡Nuevo usuario!</h1>
		<h2>Por favor ingresa los siguientes datos para crear tu usuario en la plataforma y empezar a crear objetos.</h2>
		<form action="@Url.Action("Registrar", "Usuarios")" method="post">
			@Html.AntiForgeryToken()
			<input type="text" name="nombre" id="nombre" placeholder="Nombre">
			<input type="email" name="correo" id="correo" placeholder="Correo">
			<input type="password" name="contraseña" id="contraseña" placeholder="Contraseña">
			<button type="submit">Registrar<img src="~/Content/IMGS/persona.svg" alt="nuevo usuario"></button>
		</form>
		<p>¿Ya eres usuario? <a href="/Login">Iniciar sesión</a></p>
	</div>
	<div class="logo">
		<img src="../imagenes/pera_binarizada.png" alt="pera">
	</div>
</body>
</html>