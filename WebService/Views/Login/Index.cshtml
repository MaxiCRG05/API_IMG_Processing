@{
	ViewBag.Title = "Login";
	Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.25" />
	<title>Visión Artificial</title>
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<link href="~/Content/Login.css" rel="stylesheet" />
</head>
	<body>
		<div class="login-container">
			<h1>¡BIENVENIDO!</h1>
			<h2>UTILIZA ESTE SITIO PARA CREAR PROYECTOS CON VISIÓN ARTIFICIAL PARA IDENTIFICAR OBJETOS EN TUS IMÁGENES.</h2>
			<br />
			<button class="google-btn" onclick="loginConGoogle()">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="white">
					<path d="M12.545 10.239v3.821h5.445c-0.712 2.315-2.647 3.972-5.445 3.972-3.332 0-6.033-2.701-6.033-6.032s2.701-6.032 6.033-6.032c1.498 0 2.866 0.549 3.921 1.453l2.814-2.814c-1.786-1.667-4.166-2.698-6.735-2.698-5.522 0-10 4.477-10 10s4.478 10 10 10c8.396 0 10-7.524 10-10 0-0.67-0.069-1.325-0.189-1.961h-9.811z"></path>
				</svg>
				Iniciar sesión con Google
			</button>

			<div class="divider">o</div>

			<form action="/Login" method="post">
				@Html.AntiForgeryToken()
				<div class="form-group">
					<label id="lblEmail" for="email"></label>
					<input type="email" id="email" name="email" placeholder="Correo electrónico" required>
				</div>

				<div class="form-group">
					<label id="lblPass" for="password"></label>
					<input type="password" id="password" name="password" placeholder="Contraseña" required>
				</div>

				<div class="password-link">
					<a href="/Login/Recuperar">Recuperar contraseña</a>
				</div>

				<button type="submit" class="login-btn">Iniciar sesión <img style="transform: rotate(180deg)" src="~/Content/IMGS/FlechaRegresar.png" alt="Enviar"></button>
			</form>

			<div class="signup-link">
				¿No tienes cuenta? <a href="/Login/Registro">Crear un usuario</a>.
			</div>
		</div>
		<script>
			@if(ViewBag.ErrorType != null)
			{
				<text>
					document.addEventListener('DOMContentLoaded', function() {
						if ('@ViewBag.ErrorType' === 'UsuarioInexistente') {
							usuarioInexistente();
						}
						else if ('@ViewBag.ErrorType' === 'CredencialesInvalidas') {
							loginFallido();
						}
						else if ('@ViewBag.ErrorType' === 'ExitoContraseña') {
							contraseñaCambiada();
						}
					});
				</text>
			}

			function contraseñaCambiada() {
				Swal.fire({
				title: 'Contraseña cambiada',
					text: 'Tu contraseña ha sido cambiada exitosamente.',
					icon: 'success',
					timer: 5000,
					confirmButtonText: 'Aceptar'
				}).then((result) => {
					if (result.isConfirmed) {
						window.location.href = '/Login';
					}
				});
			}

			function usuarioInexistente() {
				Swal.fire({
				title: 'Usuario inexistente',
					text: 'El usuario que intentas iniciar sesión no existe.',
					icon: 'warning',
					confirmButtonText: 'Crear usuario',
					timer: 5000
				}).then((result) => {
					if (result.isConfirmed) {
						window.location.href = '/Login/Registro';
					}
				});
			}

			function loginFallido() {
				Swal.fire({
				title: 'Error',
					text: 'Correo electrónico o contraseña incorrectos.',
					icon: 'error',
					timer: 5000,
					confirmButtonText: 'Intentar de nuevo'
				});
			}

			function loginConGoogle() {
				const clientId = '762196913246-1f707v5f5theghpt6aamv644sgapsp1v.apps.googleusercontent.com';
				const redirectUri = '/Admin';
				const scope = 'email profile';
				const responseType = 'token';

				const authUrl = `https://accounts.google.com/o/oauth2/v2/auth?client_id=${clientId}&redirect_uri=${redirectUri}&response_type=${responseType}&scope=${scope}&include_granted_scopes=true`;

				window.open(authUrl, '_blank', 'width=500,height=600');
			}
		</script>
	</body>
</html>

