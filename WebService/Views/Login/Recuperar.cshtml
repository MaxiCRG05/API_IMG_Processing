
@{
	ViewBag.Title = "Recuperar";
	Layout = "~/Views/Shared/Global.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=arrow_left_alt" />
	<link href="~/Content/Usuario.css" rel="stylesheet" />
	<title>Recuperar</title>
</head>
<body>
	<div class="contenedor-formulario">
		<button class="return-btn" title="Regresar" onclick="location.href='/Login'">
			<img src="~/Content/IMGS/FlechaRegresar.png" width="20" />
		</button>
		<h1>Recuperar contraseña</h1>
		<h2>Ingrese su correo electrónico para enviar un correo y poder reestablecer su contraseña</h2>
		<form action="/Login/Recuperar" method="post">
			@Html.AntiForgeryToken()
			<input type="email" name="correo" id="correo" placeholder="Correo">
			<button type="submit">Enviar<img src="~/Content/IMGS/enviar.svg" alt="nuevo usuario"></button>
			@if (ViewBag.Mensaje != null)
			{
				<div class="alert alert-info">
					@ViewBag.Mensaje
				</div>
			}
		</form>
	</div>
	<div class="logo">
		<img src="../imagenes/pera_binarizada.png" alt="pera">
	</div>
</body>
</html>