@{
	ViewBag.Title = "Modificar Objeto";
	Layout = "~/Views/Shared/GlobalAdmin.cshtml";
}

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
	</head>
	<body>
		@if (TempData["Success"] != null)
		{
			<script>
			Swal.fire({
				icon: 'success',
				title: '¡Éxito!',
				text: '@TempData["Success"]',
				timer: 3000,
				timerProgressBar: true,
				showConfirmButton: false
			});
			</script>
		}

		@if (TempData["Error"] != null)
		{
			<script>
			Swal.fire({
				icon: 'error',
				title: 'Error',
				text: '@TempData["Error"]',
				timer: 5000,
				timerProgressBar: true,
				showConfirmButton: true
			});
			</script>
		}
		<div class="header">
			<button class="return-btn" title="Regresar" onclick="location.href='/Admin'">
				<img src="~/Content/IMGS/FlechaRegresar.png" width="20" />
			</button>
			<h1>MODIFICAR OBJETO</h1>
		</div>
		<div class="container">
			<div class="form-section">
				<form method="post" enctype="multipart/form-data">
					@Html.AntiForgeryToken()
					<input type="file" id="archivoImagen" name="archivoImagen" accept="image/*" style="display:none">
					<input type="file" id="archivoHu" name="archivoHu" accept=".hu" style="display:none">
					<select id="Objetos" name="ObjetosID" required>
						<option disabled selected>Seleccione el objeto</option>
						@foreach (var objeto in ViewBag.Objetos)
						{
							<option value="@objeto.ID">@objeto.Nombre</option>
						}
					</select>
					<label for="NombreObjeto">
						Nombre del objeto<br />
						<input type="text" id="NombreObjeto" name="NombreObjeto" placeholder="Ej. Lapiz" required>
					</label>
					<button type="button" id="BtnImagen" onclick="document.getElementById('archivoImagen').click()">
						Subir imagen
						<img src="~/Content/IMGS/Img.png" alt="imagen" width="20" />
					</button>
					<button type="button" id="InvariantesHu" onclick="document.getElementById('archivoHu').click()">
						Subir invariantes de Hu
						<img src="~/Content/IMGS/Fx.png" alt="f(x)" width="20" />
					</button>
					<button type="submit" id="GuardarModificado">
						Guardar objeto
						<img src="~/Content/IMGS/Save.png" alt="guardar" width="20" />
					</button>
				</form>
			</div>
			<div class="preview-box">
				<img src="" class="ImgObjeto" id="ImgObjeto" />
			</div>
		</div>
	</body>
</html>
<script>
	document.getElementById('archivoImagen').addEventListener('change', function (e) {
		if (this.files[0]) {
			const reader = new FileReader();
			reader.onload = function (ex) {
				document.getElementById('ImgObjeto').src = ex.target.result;
			};
			reader.readAsDataURL(this.files[0]);

			const fileName = e.target.value.split('\\').pop();
			document.getElementById('BtnImagen').innerHTML = "Imagen cargada: \"" + fileName + "\"";
		}
	});

	document.getElementById('archivoHu').addEventListener('change', function (e) {
		if (this.files && this.files[0]) {
			const fileName = e.target.value.split('\\').pop();
			document.getElementById('InvariantesHu').innerText = "Archivo cargado: \"" + fileName + "\"";
		}
	});

	document.getElementById('Objetos').addEventListener('change', function () {
		const objetoId = this.value;
		fetch(`/Admin/ObtenerObjeto?objetoId=${objetoId}`)
			.then(response => response.json())
			.then(data => {
				document.getElementById('NombreObjeto').value = data.Nombre;
				if (data.ImagenBase64) {
					document.getElementById('ImgObjeto').src = `data:image/png;base64,${data.ImagenBase64}`;
				} else {
					document.getElementById('ImgObjeto').src = "";
				}
			});
	});

	async function subirInvariantes() {
		var invariantes = document.getElementById("InvariantesHu");

		const { value: file } = await Swal.fire({
			title: "Selecciona un archivo Hu (.hu)",
			input: "file",
			inputAttributes: {
				"accept": "*",
				"aria-label": "Sube tus invariantes"
			}
		});
		if (file) {
			const reader = new FileReader();
			invariantes.innerText = "Ya se han cargado";
			invariantes.disabled = true;
		}
	}

	async function subirImagen() {
		var imagen = document.getElementById("ImgObjeto");

		const { value: file } = await Swal.fire({
			title: "Selecciona una imagen",
			input: "file",
			inputAttributes: {
				"accept": "image/*",
				"aria-label": "Carga tu imagen"
			}
		});
		if (file) {
			const reader = new FileReader();
			reader.onload = (e) => {
				imagen.src = e.target.result
			};
			reader.readAsDataURL(file);
		}
	}
</script>