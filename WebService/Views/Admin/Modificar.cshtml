@{
	ViewBag.Title = "Modificar Objeto";
	Layout = "~/Views/Shared/GlobalAdmin.cshtml";
}

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
	</head>
	<body>
		@if (TempData["Success"] != null)
		{
			<script>
			Swal.fire({
				icon: 'success',
				title: '¡Éxito!',
				text: '@TempData["Success"]',
				timer: 3000,
				timerProgressBar: true,
				showConfirmButton: false
			});
			</script>
		}

		@if (TempData["Error"] != null)
		{
			<script>
			Swal.fire({
				icon: 'error',
				title: 'Error',
				text: '@TempData["Error"]',
				timer: 5000,
				timerProgressBar: true,
				showConfirmButton: true
			});
			</script>
		}
		<div class="header">
			<button class="return-btn" title="Regresar" onclick="location.href='/Admin'">
				<img src="~/Content/IMGS/FlechaRegresar.png" width="20" />
			</button>
			<h1>MODIFICAR OBJETO</h1>
		</div>
		<div class="container">
			<div class="form-section">
				<form method="post">

					<label for="NombreObjeto">
						Nombre del objeto<br />
						<input type="text" id="NombreObjeto" name="NombreObjeto" placeholder="Ej. Lapiz" required>
					</label>

					<select id="Objetos" name="ObjetosID">
						<option disabled selected>Seleccione el objeto</option>
						@foreach (var objeto in ViewBag.Objetos)
						{
							<option value="@objeto.ID">@objeto.Nombre</option>
						}
					</select>

					<button type="button" id="SubirImagen">
						Subir imágen
						<img src="~/Content/IMGS/Img.png" alt="img" width="20" />
					</button>

					<button type="button" id="SubirHu">
						Subir invariantes de Hu
						<img src="~/Content/IMGS/Fx.png" alt="f(x)" width="20" />
					</button>

					<button type="submit" id="GuardarModificado">
						Guardar objeto
						<img src="~/Content/IMGS/Save.png" alt="guardar" width="20" />
					</button>
				</form>
			</div>
			<div class="preview-box">
				<img src="" class="ImgObjeto" id="ImgObjeto" />
			</div>
		</div>
	</body>
</html>
