@{
	ViewBag.Title = "Agregar";
	Layout = "~/Views/Shared/GlobalAdmin.cshtml";
}

<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link href="~/Content/Layout.css" rel="stylesheet" />
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<title>Agregar Objeto</title>
	<style>
		.container {
			display: flex;
			justify-content: space-between;
			padding: 40px;
		}

		.form-section {
			margin-top: 50px;
			width: 45%;
		}

			.form-section input,
			.form-section select,
			.form-section button {
				min-width: 400px;
				padding: 12px;
				margin: 20px 0px 20px 0px;
				border-radius: 20px;
				border: 2px solid #aac0d4;
				font-size: 16px;
				transition: 0.3s ease-in-out;
			}

			.form-section select {
				text-align: center;
			}

			.form-section button {
				background-color: #8daac8;
				color: white;
				border: none;
				font-weight: bold;
				display: flex;
				align-items: center;
				justify-content: center;
			}

				.form-section button:hover {
					background-color: #304D6D;
					border-color: yellow;
					border: 2px;
				}

				.form-section button img {
					margin-left: 8px;
				}

		.preview-box {
            flex-grow: 1;
            border: 2px dashed #2f4668;
            border-radius: 16px;
            background-color: #f0f5fc;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
            transition: all 0.3s;
            min-height: 400px;
        }
        
        .preview-box:hover {
            border-color: #4a8fd6;
            box-shadow: inset 0 0 15px rgba(74, 143, 214, 0.2);
        }
        
        #ImgObjeto {
            border-radius: 10px;
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }
	</style>
</head>
<body>

	<div class="header">
		<button class="return-btn" title="Regresar" onclick="location.href='/Admin'">
			<img src="~/Content/IMGS/FlechaRegresar.png" width="20" />
		</button>
		<h1>AGREGAR OBJETO</h1>
	</div>

	<div class="container">
		<div class="form-section">
			<form method="post">
				<label for="NombreObjeto">
					Nombre del objeto<br/>
					<input type="text" id="NombreObjeto" placeholder="Ej. Lapiz">
				</label>
				<select id="Categoria" name="Categoria">
					<option disabled selected>Seleccione la categoría</option>
					@foreach (var categoria in ViewBag.Categorias)
					{
						<option value="@categoria.Nombre">@categoria.Nombre</option>
					}
				</select>

				<button type="button" id="NuevaCategoria" onclick="agregarCategoria()">
					Nueva categoría
					<img src="~/Content/IMGS/Cruz2.png" alt="guardar" width="20" />
				</button>

				<button type="button" id="InvariantesHu" onclick="subirInvariantes()">
					Subir invariantes de Hu
					<img src="~/Content/IMGS/Fx.png" alt="f(x)" width="20" />
				</button>

				<button type="button" id="Imagen" onclick="subirImagen()">
					Subir imagen
					<img src="~/Content/IMGS/Img.png" alt="imagen" width="20" />
				</button>

				<button type="submit" id="Guardar">
					Guardar objeto
					<img src="~/Content/IMGS/Save.png" alt="guardar" width="20" />
				</button>
			</form>
		</div>

		<div class="preview-box">
			<img src="" class="ImgObjeto" id="ImgObjeto"/>
		</div>
	</div>
</body>
</html>

<script>

	// Manejar la selección de imagen
	document.getElementById('fileImagen').addEventListener('change', function (e) {
		if (this.files && this.files[0]) {
			const reader = new FileReader();
			reader.onload = function (e) {
				document.getElementById('ImgObjeto').src = e.target.result;
			}
			reader.readAsDataURL(this.files[0]);
		}
	});

	// Manejar la selección de archivo Hu
	document.getElementById('fileHu').addEventListener('change', function (e) {
		if (this.files && this.files[0]) {
			document.getElementById('InvariantesHu').innerText = "Archivo cargado";
		}
	});

	async function agregarCategoria() {
        const { value: nombre } = await Swal.fire({
            title: 'Nueva Categoría',
            input: 'text',
            inputLabel: 'Nombre de la categoría:',
            inputPlaceholder: 'Ej. Electrónicos',
            showCancelButton: true,
            cancelButtonText: "Cancelar",
            confirmButtonText: "Crear",
            inputValidator: (value) => {
                if (!value.trim()) return '¡El nombre es obligatorio!';
                if (value.length > 50) return '¡Máximo 50 caracteres!';
            }
        });

        if (nombre) {
            const response = await fetch('@Url.Action("AgregarCategoria", "Admin")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: `nombreCategoria=${encodeURIComponent(nombre)}`
            });

            const data = await response.json();

            if (data.success) {
                // Actualizar dropdown
                const select = document.getElementById("Categoria");
                const option = document.createElement("option");
                option.value = data.id;
                option.text = data.nombre;
                select.add(option);
                select.value = data.id;

                Swal.fire({
                    icon: 'success',
                    title: '¡Categoría creada!',
                    text: `"${nombre}" fue agregada correctamente`
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: data.message || 'Error al crear categoría'
                });
            }
        }
    }

	async function subirInvariantes() {
		var invariantes = document.getElementById("InvariantesHu");

		const { value: file } = await Swal.fire({
			title: "Selecciona un archivo Hu",
			input: "file",
			inputAttributes: {
				"accept": "text/*",
				"aria-label": "Sube tus invariantes"
			}
		});
		if (file) {
			const reader = new FileReader();
			invariantes.innerText = "Ya se han cargado";
			invariantes.disabled = true;
		}
	}

	async function subirImagen() {
		var imagen = document.getElementById("ImgObjeto");

		const { value: file } = await Swal.fire({
			title: "Selecciona una imagen",
			input: "file",
			inputAttributes: {
				"accept": "image/*",
				"aria-label": "Carga tu imagen"
			}
		});
		if (file) {
			const reader = new FileReader();
			reader.onload = (e) => {
				imagen.src = e.target.result
			};
			reader.readAsDataURL(file);
		}
	}
</script>