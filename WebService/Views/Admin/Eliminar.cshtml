@{
	ViewBag.Title = "Eliminar";
	Layout = "~/Views/Shared/GlobalAdmin.cshtml";
}

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>@ViewBag.Title</title>
		<style>
			body {
				margin: 0;
				background-color: #ffffff;
				font-family: 'Inter', sans-serif;
				display: flex;
				flex-direction: column;
				align-items: center;
			}

			.header {
				background: linear-gradient(to right, #8ab3db, #2f4668);
				color: white;
				padding: 30px 0;
				text-align: center;
				font-size: 28px;
				font-weight: bold;
				letter-spacing: 1px;
				width: 100%;
			}

			.return-btn {
				position: absolute;
				top: 20px;
				left: 20px;
				background-color: #82A0BC;
				border: none;
				border-radius: 40px;
				padding: 13px 25px 13px 25px;
				cursor: pointer;
				transition: background-color 0.3s ease;
			}

				.return-btn:hover {
					background-color: #5a768f;
				}

			.form-container {
				display: flex;
				flex-direction: column;
				align-items: center;
				width: 100%;
				margin-top: 50px;
			}

			.form-section {
				width: 400px;
				display: flex;
				flex-direction: column;
				align-items: center;
			}

				.form-section select,
				.form-section button {
					width: 100%;
					min-width: 400px;
					padding: 12px;
					margin: 30px 0px 10px 0px;
					border-radius: 20px;
					border: 2px solid #aac0d4;
					font-size: 16px;
					transition: 0.3s ease-in-out;
				}

				.form-section select {
					text-align: center;
				}

				.form-section button {
					background-color: #8daac8;
					color: white;
					border: none;
					font-weight: bold;
					display: flex;
					align-items: center;
					justify-content: center;
					margin-top: 50px;
				}

					.form-section button:hover {
						background-color: #304D6D;
						border-color: yellow;
						border: 2px;
					}

					.form-section button img {
						margin-left: 8px;
					}

			.checkbox-container {
				display: flex;
				align-items: center;
			}

				.checkbox-container input[type="checkbox"] {
					margin-right: 10px;
				}

			button .submit {
				margin-top: 50%;
			}
		</style>
	</head>
	<body>

		<div class="header">
			<button class="return-btn" title="Regresar" onclick="location.href='/Admin'">
				<img src="~/Content/IMGS/FlechaRegresar.png" width="20" />
			</button>
			<h1>ELIMINAR OBJETO</h1>
		</div>

		<div class="form-container">
			<div class="form-section">
				<form method="post">
					<select id="Objeto" name="Objeto">
						<option disabled selected>Seleccione el objeto</option>
						<option>Oficina</option>
						<option>Papelería</option>
					</select>

					<select id="Categoria" name="Categoria">
						<option disabled selected>Seleccione la categoría</option>
						<option>Oficina</option>
						<option>Papelería</option>
					</select>

					<div class="checkbox-container">
						<input type="checkbox" id="BorrarCat" name="BorrarCat">
						<label for="BorrarCat">No quiero eliminar ninguna categoría</label>
					</div>

					<button type="submit" id="Eliminar" class="submit">
						Eliminar
						<img src="~/Content/IMGS/Trash.png" alt="Borrar" width="20" />
					</button>
				</form>
			</div>
		</div>
	</body>
</html>