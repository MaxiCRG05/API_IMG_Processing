@{
	ViewBag.Title = "Principal";
	Layout = "~/Views/Shared/GlobalAdmin.cshtml";
}

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
	</head>
	<body>
		<div class="header">
			<button class="logout-btn" title="Cerrar sesión" onclick="location.href='/Login/Logout'">
				<img src="~/Content/IMGS/LogOut.png" />
			</button>
			<h1>BIENVENIDO @Session["Nombre"].ToString().ToUpper()</h1>
			<p>¿QUÉ DESEA REALIZAR?</p>
		</div>
		<div class="container">
			<div class="card">
				<h2>AGREGAR OBJETO</h2>
				<div class="icon">
					<img src="~/Content/IMGS/Cruz.png" />
				</div>
				<p>Cargue nuevos objetos para los futuros proyectos de los clientes.</p>
				<br />
				<a href="/Admin/Agregar">Agregar objeto</a>
			</div>

			<div class="card">
				<h2>MODIFICAR OBJETO</h2>
				<div class="icon">
					<img src="~/Content/IMGS/Lapiz.png" />
				</div>
				<p>Modifique objetos que se hayan cargado de forma errónea y pueda volver a cargarlos.</p>
				<br />
				<a href="/Admin/Modificar">Modificar objeto</a>
			</div>

			<div class="card">
				<h2>ELIMINAR OBJETO</h2>
				<div class="icon">
					<img src="~/Content/IMGS/Eliminar.svg" />
				</div>
				<br />
				<p>Elimine objetos para que dejen de estar disponibles en los proyectos de los nuevos usuarios.</p>
				<a href="/Admin/Eliminar">Eliminar objeto</a>
			</div>
		</div>
	</body>
</html>