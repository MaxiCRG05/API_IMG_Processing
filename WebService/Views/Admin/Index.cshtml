@{
	ViewBag.Title = "Principal";
	Layout = "~/Views/Shared/GlobalAdmin.cshtml";
}

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
	</head>
	<body>
		<style>
			.container {
				flex-direction: column;
				align-items: center;
				margin-top: 50px;
				padding: 0 20px;
				gap: 80px;
			}
		</style>
		<div class="header">
			<button class="logout-btn" title="Cerrar sesión" onclick="location.href='/Login/Logout'">
				<img src="~/Content/IMGS/LogOut.png" />
			</button>
			<h1>BIENVENIDO @Session["Nombre"].ToString().ToUpper()</h1>
			<p>¿QUÉ DESEA REALIZAR?</p>
		</div>
		<div class="container">
			<div class="row">
				<div class="card">
					<h2>CONSULTAR OBJETOS</h2>
					<div class="icon">
						<img src="~/Content/IMGS/Lupa.svg" alt="Consultar">
					</div>
					<br />
					<p>Consulte los objetos ya registrados en la base de datos para uso en los proyectos.</p>
					<br />
					<a href="/Admin/Consultar">Consultar objetos</a>
				</div>

				<div class="card">
					<h2>AGREGAR OBJETO</h2>
					<div class="icon">
						<img src="~/Content/IMGS/Cruz.svg" alt="Agregar">
					</div>
					<br />
					<p>Cargue nuevos objetos para los futuros proyectos de los clientes.</p>
					<br />
					<a href="/Admin/Agregar">Agregar objeto</a>
				</div>
			</div>

			<div class="row">
				<div class="card">
					<h2>MODIFICAR OBJETO</h2>
					<div class="icon">
						<img src="~/Content/IMGS/Lapiz.svg" alt="Modificar">
					</div>
					<br />
					<p>Modifique objetos que se hayan cargado de forma errónea y pueda volver a cargarlos.</p>
					<br />
					<a href="/Admin/Modificar">Modificar objeto</a>
				</div>

				<div class="card">
					<h2>ELIMINAR OBJETO</h2>
					<div class="icon">
						<img src="~/Content/IMGS/Eliminar.svg" alt="Eliminar">
					</div>
					<br />
					<p>Elimine objetos dentro de la base de datos para controlar el uso en los proyectos.</p>
					<br />
					<a href="/Admin/Eliminar">Eliminar objeto</a>
				</div>
			</div>
		</div>
	</body>
</html>