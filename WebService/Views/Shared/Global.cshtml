<!DOCTYPE html>
<html>

<body>
	@RenderBody()
	<style>
		
		.return-btn {
			position: absolute;
			top: 20px;
			left: 20px;
			background-color: #82A0BC;
			border: none;
			border-radius: 40px;
			padding: 13px 25px 13px 25px;
			cursor: pointer;
			transition: background-color 0.3s ease;
		}

			.return-btn:hover {
				background-color: #5a768f;
			}

		a {
			color: #3498db;
			text-decoration: none;
		}

		.logout-btn {
			position: absolute;
			top: 20px;
			right: 20px;
			background-color: #82A0BC;
			border: none;
			border-radius: 30%;
			padding: 13px 20px 13px 24px;
			cursor: pointer;
			transition: background-color 0.5s ease-in-out;
		}

			.logout-btn:hover {
				background-color: #333;
			}
	</style>


</body>
</html>
